# ---------------------------------------------------------------------------
# nexuscentral environment
# Copy to .env and fill in. .env is gitignored; this file is not.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# PostgreSQL 16 connection string. In Docker Compose the host is the service
# name (`postgres`); for local development it is usually `localhost`.
DATABASE_URL=postgres://nexuscentral:nexuscentral@localhost:5432/nexuscentral

# Credentials used by the `postgres` service in docker-compose.yml.
POSTGRES_USER=nexuscentral
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexuscentral

# --- Authentication --------------------------------------------------------
# Optional. Setting the password from the command line is both simpler and safer
# than putting it here, and it works at any time rather than only on first boot:
#
#   docker compose exec -it api node dist/cli/set-password.js
#
# If you do use this variable: it is read ONCE, on the first boot that finds no
# stored password, and ignored ever after -- changing it later does nothing. At
# least 12 characters; length is what matters and there is no composition rule.
#
# Avoid `$`. Compose expands it in .env values when a name follows, so
# `hunter$secret` arrives as `hunter` and locks you out with a password you never
# typed. deploy.sh refuses that case.
#
# Remove it after the first sign-in: a password left here is a password in every
# backup of this file. The API warns on every start while it is still set.
AUTH_PASSWORD=

# --- HTTP server -----------------------------------------------------------
# Interface the API listens on. Defaults to loopback. Inside Docker Compose this
# must be 0.0.0.0 so the `web` container can reach it -- the API is never
# published to the host in that setup.
BIND_ADDR=127.0.0.1
PORT=3000

# `production` | `development` | `test`
NODE_ENV=development

# Where the `web` container (SPA + /api proxy) is published. Loopback only: the
# host Nginx terminates TLS and authenticates before proxying here.
WEB_BIND_ADDR=127.0.0.1
WEB_PORT=8080

# Number of reverse proxies in front of the API, passed to Express
# `trust proxy`. Leave unset when there is no proxy. Setting BIND_ADDR to
# 0.0.0.0 without this logs a startup warning -- and it matters more than it
# looks: the login rate limiter counts per client IP, and without this every
# request appears to come from the proxy, collapsing it into one bucket.
TRUST_PROXY=

# --- Workers ---------------------------------------------------------------
# Run the pg-boss workers in the same process as the API server. Set to false
# to run a dedicated worker container.
WORKER_ENABLED=true

# --- Logging ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Pretty-print logs instead of emitting JSON. Development only.
LOG_PRETTY=false

# --- Reddit ----------------------------------------------------------------
# OAuth2 client-credentials app. App registration is not self-service and
# approval takes 2-4 weeks; register early. When unset, Reddit sources are
# created but left inactive.
# These win over the values stored in the `settings` table.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit blocks generic user agents. Keep this descriptive and stable.
REDDIT_USER_AGENT=nexuscentral/1.0 (self-hosted personal aggregator)

# --- Nitter (X/Twitter, best-effort) ---------------------------------------
# Comma-separated, ordered list of instance base URLs. Self-hosted first.
NITTER_BASE_URLS=

# --- Custom API widgets ----------------------------------------------------
# Allow custom_api widgets to target private/link-local address ranges.
# Keep false in production: this is the SSRF guard.
ALLOW_PRIVATE_TARGETS=false

# --- Update check ----------------------------------------------------------
# Compares the deployed commit with the head of the public repository, one
# request to GitHub cached for thirty minutes. No token: the repository is
# public and GitHub allows 60 unauthenticated requests an hour per IP.
#
# GIT_SHA is set by deploy.sh from the commit it checks out -- do not set it by
# hand. Without it the check reports "cannot tell" instead of guessing.
# UPDATE_REPO=Exe64/nexuscentral
# UPDATE_CHECK_ENABLED=true

# ---------------------------------------------------------------------------
# VPS deployment (read by docker-compose.vps.yml and deploy.sh)
# Only needed on the server. See README > Deployment.
# ---------------------------------------------------------------------------

# Hostname Traefik routes to this app, and the certresolver defined in
# /opt/traefik. Same keys as the other apps on the VPS.
DOMAIN=
TRAEFIK_CERTRESOLVER=letsencrypt

# There is no basic-auth setting here any more. The application authenticates
# for itself: see AUTH_PASSWORD above.

# --- Backups ---------------------------------------------------------------
# Read by deploy/backup-db.sh. deploy.sh takes a dump before every migration.
# NEXUSCENTRAL_BACKUP_DIR=/opt/apps/nexuscentral/backups
# NEXUSCENTRAL_BACKUP_KEEP=14
# Encrypt the dumps at rest. Without it they are plain gzip.
# NEXUSCENTRAL_BACKUP_PASSPHRASE_FILE=/root/.nexuscentral-backup-pass
# Off-machine copy: a dump that only exists on the VPS does not survive the VPS.
# NEXUSCENTRAL_RCLONE_REMOTE=gdrive:nexuscentral-backups
# Dead-man's-switch (healthchecks.io): alerts when backups stop running.
# NEXUSCENTRAL_HEALTHCHECK_URL=
