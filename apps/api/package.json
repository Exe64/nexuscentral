{
  "name": "@nexuscentral/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "node-pg-migrate --migrations-dir ${MIGRATIONS_DIR:-../../migrations} --migration-file-language js --migration-filename-format utc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nexuscentral/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.6",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
